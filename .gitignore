# ==============================================================================
# Git Ignore Configuration for ceVAE+ PyTorch Medical AI Repository
# ==============================================================================

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# C extensions & Distribution
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual Environments
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/

# Environment Variables & Secrets
.env
.env.*
*.secret
*.key

# Model Checkpoints & Weights (Large Binaries > 50MB)
*.pt
*.pth
*.pwf
*.bin
*.onnx
*.safetensors
checkpoints/*.pt
checkpoints/*.pth
!checkpoints/.gitkeep

# Medical Imaging Data & Raw Volumes
data/*
!data/dataset_128.zip
!data/IXI-T1.zip
*.nii
*.nii.gz
*.dcm
*.h5
*.hdf5
*.npz

# Logs & Monitoring
*.log
runs/
wandb/
.tensorboard/

# Jupyter Notebook Checkpoints
.ipynb_checkpoints
*/.ipynb_checkpoints/*

# IDE & OS Artifacts
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# Large Result Runs (Keep smoke test demo figure)
results/*
!results/smoke_test_diagnostic.png
!results/.gitkeep

# Local Scratch / Test Scripts
scratch/
